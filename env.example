# «Produção» local · local "production" — copiar para .env · copy to .env
#   cp env.example .env
# PT: o .env é lido pelo Docker Compose e NUNCA vai para o git nem para dentro de uma imagem.
# EN: .env is read by Docker Compose and NEVER goes into git or into an image.

# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-generate-a-real-one

# qualquer valor: só vive no volume local · any value: it only lives in the local volume
POSTGRES_PASSWORD=change-me

# http://localhost não tem TLS. Em produção apaga-se esta linha: o valor por omissão é true.
# http://localhost has no TLS. In production delete this line: the default is true.
HTTPS=false

ALLOWED_HOSTS=localhost

# 8080 se a porta 80 estiver ocupada · if port 80 is busy
HTTP_PORT=80

# --- Desenvolvimento (uv run python manage.py runserver) · development -------------------
# Para correr fora do Docker, como nas fichas anteriores, descomentar estas linhas no .env
# (e `docker compose up -d` para o PostgreSQL e o Redis).
# To run outside Docker, as in the earlier fichas, uncomment these lines in .env.
# DEBUG=true
# DATABASE_URL=postgres://dwfa:dwfa@localhost:5432/dwfa
# REDIS_URL=redis://localhost:6379
# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:5173
