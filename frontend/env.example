# Desenvolvimento (npm run dev) · development — copiar para .env · copy to .env
#   cp env.example .env
# PT: as variáveis VITE_* são públicas e ficam fixas no JavaScript no build. Nunca um segredo.
# EN: VITE_* variables are public and baked into the JavaScript at build time. Never a secret.
# Na imagem de produção o Dockerfile define VITE_API_URL="" (mesma origem, atrás do Nginx).
# In the production image the Dockerfile sets VITE_API_URL="" (same origin, behind Nginx).
VITE_API_URL=http://localhost:8000
